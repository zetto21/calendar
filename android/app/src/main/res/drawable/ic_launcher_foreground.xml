<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="22.222222%">
    <!-- Adaptive icons display only the central safe zone. Keep the complete
         calendar-and-sun artwork inside it so no edges are clipped. A percentage
         scales with small app-info/notification bounds; fixed dp can erase it. -->
    <bitmap
        android:gravity="fill"
        android:src="@drawable/ic_launcher_foreground_image" />
</inset>
