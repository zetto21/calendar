<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
 android:padding="14dp" android:background="@drawable/calendar_widget_background">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="일상 캘린더" android:textColor="@color/calendar_widget_accent" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="10월 7일 수요일" android:textColor="@color/calendar_widget_text" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="예정된 일정이 없어요" android:textColor="@color/calendar_widget_secondary" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" android:visibility="gone"/>
 <LinearLayout android:id="@+id/widget_events" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="10dp"/>
</LinearLayout>
