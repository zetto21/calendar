<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash screen. The icon asset includes padding so
         the calendar artwork is smaller than the system's default icon size. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <!-- Flutter applies NormalTheme via the activity metadata in AndroidManifest.xml. -->
    </style>
</resources>
